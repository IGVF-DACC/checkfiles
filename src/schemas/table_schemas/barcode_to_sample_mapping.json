{
    "fields": [
        {
            "name": "barcode",
            "type": "string",
            "description": "the actual barcode",
            "constraints": {
                "required": true
            }
        },
        {
            "name": "sample accession",
            "type": "string",
            "description": "the IGVF accession. this can be a comma separated list",
            "constraints": {
                "required": true,
                "pattern": "^IGVFSM[0-9][0-9][0-9][0-9][A-Z][A-Z][A-Z][A-Z](,IGVFSM[0-9][0-9][0-9][0-9][A-Z][A-Z][A-Z][A-Z])*$"
            }
        },
        {
            "name": "sample description",
            "type": "string",
            "description": "Lab alias or English definition of the sample. this can be a comma separated list",
            "constraints": {
                "required": true
            }
        },
        {
            "name": "position",
            "type": "integer",
            "description": "For use with complex barcoding systems,  position is the zero based array offset location of the start of the sample identifying barcode sequence",
            "constraints": {
                "required": true,
                "minimum": 0
            }
        },
        {
            "name": "parse barcode type",
            "type": "string",
            "description": "For parse seq (R for random or T for poly-A primed)",
            "constraints": {
                "required": true,
                "enum": [
                    "R",
                    "T"
                ]
            }
        },
        {
            "name": "well",
            "type": "string",
            "description": "For multi-well samples",
            "constraints": {
                "required": true
            }
        }
    ]
}
